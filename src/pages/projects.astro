---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = await getCollection('projects');
const order = ['llm', 'indus', 'other'];
const sorted = projects.sort((a, b) => {
  const ta = order.indexOf(a.data.track);
  const tb = order.indexOf(b.data.track);
  if (ta !== tb) return ta - tb;
  return Number(b.data.featured) - Number(a.data.featured);
});
---

<Layout
  title="Projects | Tanishk Tiwari"
  description="Research projects and software artifacts by Tanishk Tiwari — LLM inference, mechanistic interpretability, Indus script analysis, and quantum ML experiments."
>
  <div class="shell section">
    <div class="section-head reveal">
      <div>
        <span class="section-num">WORK</span>
        <h1 class="display-lg">Projects &amp; <span class="serif text-acid">artifacts.</span></h1>
      </div>
      <div class="flex flex-wrap gap-2 no-print" id="filters">
        <button class="btn btn-primary py-2 px-3 filter-btn" data-filter="all">All</button>
        <button class="btn btn-outline py-2 px-3 filter-btn" data-filter="llm">LLM Systems</button>
        <button class="btn btn-outline py-2 px-3 filter-btn" data-filter="indus">Indus</button>
        <button class="btn btn-outline py-2 px-3 filter-btn" data-filter="other">Exploratory</button>
      </div>
    </div>

    <div class="grid gap-5 md:grid-cols-2" id="projects-grid">
      {sorted.map((proj) => (
        <div class="project-item reveal" data-track={proj.data.track}>
          <ProjectCard project={proj} />
        </div>
      ))}
    </div>
  </div>
</Layout>

<script>
  function setupProjectFilters() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const items = document.querySelectorAll<HTMLElement>('.project-item');
    buttons.forEach((btn) => {
      const fresh = btn.cloneNode(true) as HTMLButtonElement;
      btn.parentNode?.replaceChild(fresh, btn);
      fresh.addEventListener('click', () => {
        const filter = fresh.getAttribute('data-filter') || 'all';
        document.querySelectorAll<HTMLButtonElement>('.filter-btn').forEach((b) => {
          b.classList.remove('btn-primary');
          b.classList.add('btn-outline');
        });
        fresh.classList.add('btn-primary');
        fresh.classList.remove('btn-outline');
        items.forEach((item) => {
          const track = item.getAttribute('data-track');
          item.style.display = filter === 'all' || track === filter ? '' : 'none';
        });
      });
    });
  }
  setupProjectFilters();
  document.addEventListener('astro:after-swap', setupProjectFilters);
</script>
