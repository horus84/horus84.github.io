---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PublicationCard from '../components/PublicationCard.astro';

const allProjects = await getCollection('projects');
const llmProjects = allProjects.filter((p) => p.data.track === 'llm');
const indusProjects = allProjects.filter((p) => p.data.track === 'indus');
const otherProjects = allProjects.filter((p) => p.data.track === 'other');

const allPublications = await getCollection('publications');
const llmPubs = allPublications.filter((pub) => pub.data.tags.some((t) => /llm|cache|transformer/i.test(t)));
const indusPubs = allPublications.filter((pub) => pub.data.tags.some((t) => /indus/i.test(t)));
---

<Layout
  title="Research | Tanishk Tiwari"
  description="Research tracks by Tanishk Tiwari: efficient LLM inference, mechanistic interpretability, Indus sign sequence analysis, and quantum ML trainability."
>
  <div class="shell section">
    <div class="section-head reveal">
      <div>
        <span class="section-num">RESEARCH</span>
        <h1 class="display-lg">Questions with <span class="serif text-acid">measurable</span> answers.</h1>
      </div>
      <p class="label max-w-[24rem]">Systems efficiency, sequence structure, and careful evaluation.</p>
    </div>

    <!-- Track A -->
    <section id="track-a" class="scroll-mt-24 py-12 border-b border-line">
      <div class="grid gap-10 lg:grid-cols-[280px_1fr]">
        <div class="reveal">
          <p class="label label-acid mb-4">Track 01</p>
          <h2 class="section-title">LLM inference &amp; mechanistic interpretability</h2>
          <p class="label mt-4">Systems · Model internals</p>
        </div>
        <div class="space-y-8 reveal">
          <div class="text-sm text-dim leading-relaxed space-y-4 max-w-3xl">
            <p>
              Long-context language models pay a memory tax: the KV cache grows linearly, dominates VRAM, and limits
              concurrency. I’m building value-focused KV-cache compression that preserves the information attention
              actually uses — through adaptive low-rank representations, salient residual preservation, and compressed
              attention computation.
            </p>
            <p>
              In parallel, I’m developing a mechanistic interpretability probe suite for open-weight Qwen models:
              forward hooks, residual-stream activations, attention-head specialisation, and activation-patching
              interventions to understand reasoning behaviour from the inside.
            </p>
          </div>
          <div class="panel p-5">
            <p class="label mb-3">Method</p>
            <ul class="text-sm text-dim space-y-2">
              <li class="flex gap-3"><span class="text-acid font-mono text-xs mt-0.5">→</span><span>Benchmark quality, memory, latency, throughput, perplexity, and long-context task performance.</span></li>
              <li class="flex gap-3"><span class="text-acid font-mono text-xs mt-0.5">→</span><span>Implement in PyTorch and Hugging Face Transformers; prepare work for ACL Rolling Review.</span></li>
              <li class="flex gap-3"><span class="text-acid font-mono text-xs mt-0.5">→</span><span>Use activation patching and head-level analysis to connect behaviour to internal mechanisms.</span></li>
            </ul>
          </div>
          {llmProjects.length > 0 && (
            <div>
              <p class="label mb-4">Artifacts</p>
              <div class="grid gap-5 sm:grid-cols-2">
                {llmProjects.map((proj) => <ProjectCard project={proj} />)}
              </div>
            </div>
          )}
          {llmPubs.length > 0 && (
            <div>
              <p class="label mb-4">Related writing</p>
              {llmPubs.map((pub) => <PublicationCard publication={pub} />)}
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- Track B -->
    <section id="track-b" class="scroll-mt-24 py-12 border-b border-line">
      <div class="grid gap-10 lg:grid-cols-[280px_1fr]">
        <div class="reveal">
          <p class="label label-ember mb-4">Track 02</p>
          <h2 class="section-title">Computational analysis of Indus sign sequences</h2>
          <p class="label mt-4">Epigraphy · Statistical NLP</p>
        </div>
        <div class="space-y-8 reveal">
          <div class="text-sm text-dim leading-relaxed space-y-4 max-w-3xl">
            <p>
              The Indus script remains undeciphered. Rather than overclaiming decipherment, I ask a narrower question:
              do sign sequences exhibit statistical structure that simple chance or frequency effects cannot explain?
            </p>
            <p>
              I built and harmonised a corpus of 6,000+ inscriptions, then analysed conditional entropy, PMI, positional
              regularity, directional asymmetry, HMM structure, and BiLSTM next-token prediction. Reversal and
              perturbation experiments served as controls.
            </p>
          </div>
          <div class="panel p-5">
            <p class="label mb-3">Outcome</p>
            <p class="text-sm text-dim">
              Published as <span class="text-bone">“Statistical Structure in Indus Sign Sequences”</span> in NLP4DH 2026,
              co-located with ACL 2026, and presented in San Diego.
            </p>
          </div>
          {indusProjects.length > 0 && (
            <div>
              <p class="label mb-4">Artifacts</p>
              <div class="grid gap-5 sm:grid-cols-2">
                {indusProjects.map((proj) => <ProjectCard project={proj} />)}
              </div>
            </div>
          )}
          {indusPubs.length > 0 && (
            <div>
              <p class="label mb-4">Publications</p>
              {indusPubs.map((pub) => <PublicationCard publication={pub} />)}
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- Track C -->
    <section id="track-c" class="scroll-mt-24 py-12">
      <div class="grid gap-10 lg:grid-cols-[280px_1fr]">
        <div class="reveal">
          <p class="label mb-4">Track 03</p>
          <h2 class="section-title">Quantum ML trainability</h2>
          <p class="label mt-4">Exploratory · Theory</p>
        </div>
        <div class="space-y-8 reveal">
          <div class="text-sm text-dim leading-relaxed space-y-4 max-w-3xl">
            <p>
              An exploratory thread investigating how mixed-state noise affects trainability in parameterized quantum
              circuits. I build experiments in PennyLane and PyTorch with amplitude damping and non-unitary operations,
              measuring gradient variance across circuit depths and noise settings to study barren-plateau behaviour.
            </p>
          </div>
          {otherProjects.length > 0 && (
            <div>
              <p class="label mb-4">Artifacts</p>
              <div class="grid gap-5 sm:grid-cols-2">
                {otherProjects.map((proj) => <ProjectCard project={proj} />)}
              </div>
            </div>
          )}
        </div>
      </div>
    </section>
  </div>
</Layout>
