---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PublicationCard from '../components/PublicationCard.astro';

const publications = await getCollection('publications');
const projects = await getCollection('projects');
const talks = await getCollection('talks');

const featuredPublications = publications
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.year - a.data.year);

const marqueeTerms = [
  'KV-cache compression',
  'Mechanistic interpretability',
  'Qwen attention heads',
  'Indus sign sequences',
  'Conditional entropy',
  'Barren plateaus',
  'Long-context inference',
  'Sequence modelling',
];
---

<Layout>
  <!-- ================= HERO ================= -->
  <section class="hero shell">
    <div class="grid gap-12 lg:grid-cols-[1fr_290px] lg:items-end">
      <div>
        <p class="hero-kicker reveal">B.Tech AI &amp; ML · Delhi Skill and Entrepreneurship University</p>

        <h1 class="display-xl mt-8 reveal">
          Efficient <span class="serif text-acid">inference.</span><br />
          Legible <span class="serif text-acid">structure.</span>
        </h1>

        <p class="hero-lede mt-8 reveal">
          I'm <strong class="text-bone font-semibold">Tanishk Tiwari</strong> — an undergraduate researcher
          in New Delhi. I compress the memory bottleneck in long-context language models,
          probe how open-weight models reason internally, and look for statistical structure
          in 6,000+ undeciphered Indus inscriptions.
        </p>

        <div class="flex flex-wrap items-center gap-4 mt-10 reveal no-print">
          <a href="/research" class="btn btn-primary">Explore the research <span aria-hidden="true">→</span></a>
          <a href="/cv/tanishk-tiwari-cv.pdf" download class="btn btn-outline">Download CV ↓</a>
        </div>
      </div>

      <aside class="panel p-5 reveal hidden lg:block" aria-label="Current status">
        <div class="flex items-center justify-between pb-4 border-b border-line">
          <span class="label">Status</span>
          <span class="status"><span class="status-dot"></span> Active</span>
        </div>
        <dl class="mt-5 space-y-4 font-mono text-[0.72rem]">
          <div class="flex justify-between gap-4">
            <dt class="text-faint">BASE</dt><dd>New Delhi, IN</dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="text-faint">TRACK</dt><dd>AI &amp; ML / 2028</dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="text-faint">FOCUS</dt><dd class="text-acid text-right">Systems + Sequence</dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="text-faint">GPA</dt><dd>8.2 / 10</dd>
          </div>
        </dl>
        <div class="mt-6 pt-4 border-t border-line hero-ascii" aria-hidden="true">
          ┌ kv ──┐   ┌ attn ──┐
          │  ▒▒  │ → │  ▓▓▓▓  │
          └──────┘   └────────┘
        </div>
      </aside>
    </div>
  </section>

  <!-- ================= MARQUEE ================= -->
  <div class="marquee no-print" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1].map(() => (
        <div class="marquee-group">
          {marqueeTerms.map((term) => <span>{term}</span>)}
        </div>
      ))}
    </div>
  </div>

  <!-- ================= NUMBERS ================= -->
  <section class="shell section-tight">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-0">
      <div class="stat reveal">
        <p class="stat-value">>6k</p>
        <p class="stat-label">Indus inscriptions in corpus</p>
      </div>
      <div class="stat reveal">
        <p class="stat-value">4×</p>
        <p class="stat-label">KV-cache compression target</p>
      </div>
      <div class="stat reveal">
        <p class="stat-value">2026</p>
        <p class="stat-label">NLP4DH / ACL presenter</p>
      </div>
      <div class="stat reveal">
        <p class="stat-value">03</p>
        <p class="stat-label">Active research tracks</p>
      </div>
    </div>
  </section>

  <!-- ================= RESEARCH TRACKS ================= -->
  <section class="shell section" id="tracks">
    <div class="section-head reveal">
      <div>
        <span class="section-num">01 / RESEARCH</span>
        <h2 class="section-title">Three questions, one method</h2>
      </div>
      <a href="/research" class="text-link no-print">Full research programme <span aria-hidden="true">→</span></a>
    </div>

    <div class="grid gap-5 md:grid-cols-3">
      <a href="/research#track-a" class="track-card panel panel-hover reveal">
        <span class="track-index" aria-hidden="true">01</span>
        <div>
          <p class="label label-acid">Active · Systems</p>
          <h3 class="text-2xl font-semibold mt-5">Efficient LLM inference</h3>
          <p class="text-sm text-dim mt-4">
            Value-focused KV-cache compaction, low-rank residuals and compressed attention
            for long-context generation. Benchmarked on quality, VRAM, latency and perplexity.
          </p>
        </div>
        <div class="flex flex-wrap gap-2 mt-8">
          <span class="tag">PyTorch</span><span class="tag">Transformers</span><span class="tag">ACL RR</span>
        </div>
      </a>

      <a href="/research#track-b" class="track-card panel panel-hover reveal">
        <span class="track-index" aria-hidden="true">02</span>
        <div>
          <p class="label label-ember">Published · Epigraphy</p>
          <h3 class="text-2xl font-semibold mt-5">Indus sign sequences</h3>
          <p class="text-sm text-dim mt-4">
            Conditional entropy, PMI, HMM structure and BiLSTM next-token prediction across
            a harmonised corpus — with reversal and perturbation controls.
          </p>
        </div>
        <div class="flex flex-wrap gap-2 mt-8">
          <span class="tag">NLP4DH 2026</span><span class="tag">SciPy</span><span class="tag">Statistical NLP</span>
        </div>
      </a>

      <a href="/research#track-c" class="track-card panel panel-hover reveal">
        <span class="track-index" aria-hidden="true">03</span>
        <div>
          <p class="label">Exploratory · Theory</p>
          <h3 class="text-2xl font-semibold mt-5">Quantum trainability</h3>
          <p class="text-sm text-dim mt-4">
            Mixed-state PennyLane experiments with amplitude damping and non-unitary channels,
            measuring gradient variance and barren-plateau behaviour.
          </p>
        </div>
        <div class="flex flex-wrap gap-2 mt-8">
          <span class="tag">PennyLane</span><span class="tag">NumPy</span><span class="tag">Optuna</span>
        </div>
      </a>
    </div>
  </section>

  <!-- ================= SELECTED WORK ================= -->
  <section class="shell section" id="work">
    <div class="section-head reveal">
      <div>
        <span class="section-num">02 / WORK</span>
        <h2 class="section-title">Selected work &amp; artifacts</h2>
      </div>
      <a href="/projects" class="text-link no-print">All projects <span aria-hidden="true">→</span></a>
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      {projects.slice(0, 4).map((project) => (
        <div class="reveal"><ProjectCard project={project} /></div>
      ))}
    </div>
  </section>

  <!-- ================= FIELD NOTES / NOW ================= -->
  <section class="shell section" id="now">
    <div class="section-head reveal">
      <div>
        <span class="section-num">03 / IN PROGRESS</span>
        <h2 class="section-title">On the bench right now</h2>
      </div>
      <a href="/now" class="text-link no-print">Field notes <span aria-hidden="true">→</span></a>
    </div>

    <div class="grid gap-x-12 gap-y-2 lg:grid-cols-2">
      <div class="fieldnote reveal">
        <span class="label">2026 —</span>
        <div>
          <p class="font-semibold">Value-focused KV-cache framework</p>
          <p class="text-sm text-dim mt-1">Adaptive low-rank representations and salient residual preservation; ablations in progress.</p>
          <span class="status mt-3"><span class="status-dot"></span> Building + benchmarking</span>
        </div>
      </div>
      <div class="fieldnote reveal">
        <span class="label">2026 —</span>
        <div>
          <p class="font-semibold">Qwen activation probe suite</p>
          <p class="text-sm text-dim mt-1">Modular forward hooks for attention-head specialisation and activation patching.</p>
          <span class="status mt-3"><span class="status-dot"></span> Instrumentation</span>
        </div>
      </div>
      <div class="fieldnote reveal">
        <span class="label">2026 —</span>
        <div>
          <p class="font-semibold">Mixed-state QML trainability</p>
          <p class="text-sm text-dim mt-1">Gradient-variance sweeps over circuit depth and noise using PyTorch + PennyLane.</p>
          <span class="status mt-3"><span class="status-dot ember"></span> Exploratory</span>
        </div>
      </div>
      <div class="fieldnote reveal">
        <span class="label">2025 ✓</span>
        <div>
          <p class="font-semibold">Indus corpus pipeline</p>
          <p class="text-sm text-dim mt-1">6,000+ inscriptions harmonised; published at NLP4DH 2026 and presented in San Diego.</p>
          <span class="status mt-3"><span class="status-dot dim"></span> Published</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= PUBLICATIONS ================= -->
  <section class="shell section" id="papers">
    <div class="section-head reveal">
      <div>
        <span class="section-num">04 / WRITING</span>
        <h2 class="section-title">Papers &amp; notes</h2>
      </div>
      <a href="/publications" class="text-link no-print">All publications <span aria-hidden="true">→</span></a>
    </div>

    <div>
      {featuredPublications.map((pub) => (
        <div class="reveal"><PublicationCard publication={pub} /></div>
      ))}
    </div>

    <div class="mt-10 panel p-6 lg:p-8 reveal">
      <p class="label mb-4">Recognition</p>
      <div class="grid gap-6 md:grid-cols-3">
        <div>
          <p class="font-semibold">EACL 2026 SRW Mentorship</p>
          <p class="text-sm text-dim mt-1">Selected internationally for pre-submission mentorship.</p>
        </div>
        <div>
          <p class="font-semibold">NLP4DH 2026, ACL</p>
          <p class="text-sm text-dim mt-1">Presenter in San Diego, USA.</p>
        </div>
        <div>
          <p class="font-semibold">RMRL Invited Lecture</p>
          <p class="text-sm text-dim mt-1">“Reading the Indus Anew”, Chennai, 2025.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= TOOLKIT ================= -->
  <section class="shell section-tight">
    <div class="panel p-7 lg:p-10 reveal">
      <p class="label label-acid mb-6">Toolkit</p>
      <div class="grid gap-x-8 gap-y-5 sm:grid-cols-2 lg:grid-cols-4 font-mono text-[0.78rem]">
        <div>
          <p class="text-faint mb-2">LANGUAGES</p>
          <p>Python · C++ · Go · SQL · Bash</p>
        </div>
        <div>
          <p class="text-faint mb-2">ML / LLM</p>
          <p>PyTorch · Transformers · scikit-learn · XGBoost</p>
        </div>
        <div>
          <p class="text-faint mb-2">SCIENTIFIC</p>
          <p>NumPy · pandas · SciPy · Optuna · PennyLane</p>
        </div>
        <div>
          <p class="text-faint mb-2">SYSTEMS</p>
          <p>Git · Linux · Docker · REST APIs · Streamlit · LaTeX</p>
        </div>
      </div>
      <div class="mt-8 pt-6 border-t border-line flex flex-wrap items-center gap-6">
        <a href="/about" class="text-link">More about me <span aria-hidden="true">→</span></a>
        <span class="label">{talks.length} talks · {publications.length} publications</span>
      </div>
    </div>
  </section>
</Layout>
