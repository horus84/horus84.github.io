---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PublicationCard from '../components/PublicationCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TalkCard from '../components/TalkCard.astro';

const allPublications = await getCollection('publications');
const featuredPublications = allPublications
  .filter(pub => pub.data.featured)
  .sort((a, b) => b.data.year - a.data.year);

const allProjects = await getCollection('projects');
const featuredProjects = allProjects.filter(p => p.data.featured);

const allTalks = await getCollection('talks');
const featuredTalks = allTalks.filter(t => t.data.featured).slice(0, 2);
---

<Layout>
  <!-- Hero Section -->
  <section class="border-b border-brand-border/40 pb-12 md:pb-16 mb-16 relative">
    <div class="max-w-3xl space-y-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-brand-sand text-brand-slate text-xs font-semibold uppercase tracking-wider border border-brand-border/30">
        Delhi Skill and Entrepreneurship University
      </div>
      
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-brand-slate leading-tight font-lora">
        Researching structure, memory and meaning in <span class="text-brand-rust italic font-normal">intelligent systems</span>.
      </h1>
      
      <p class="text-lg md:text-xl text-stone-600 font-light leading-relaxed max-w-2xl">
        I am an undergraduate AI researcher working across efficient language model inference, computational linguistics, and the statistical structure of ancient sign systems.
      </p>

      <div class="flex flex-wrap items-center gap-4 pt-4 no-print">
        <a 
          href="/cv" 
          class="inline-flex items-center justify-center px-5 py-2.5 bg-brand-slate text-white hover:bg-brand-rust font-semibold rounded shadow transition-all duration-150 text-sm focus:outline-none focus:ring-2 focus:ring-brand-rust"
        >
          View Full CV
        </a>
        <a 
          href="/contact" 
          class="inline-flex items-center justify-center px-5 py-2.5 border border-brand-border text-brand-slate hover:bg-brand-sand/40 font-semibold rounded shadow-sm transition-all duration-150 text-sm focus:outline-none focus:ring-2 focus:ring-brand-rust"
        >
          Contact Me
        </a>
      </div>
    </div>

    <!-- Sequence-inspired background SVG motif (abstract & elegant) -->
    <div class="absolute right-0 bottom-4 opacity-5 hidden lg:block select-none pointer-events-none" aria-hidden="true">
      <svg width="240" height="240" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="50" cy="50" r="45" stroke="#1c2d42" stroke-width="0.5" stroke-dasharray="1 3"/>
        <line x1="50" y1="5" x2="50" y2="95" stroke="#9c422c" stroke-width="0.25"/>
        <line x1="5" y1="50" x2="95" y2="50" stroke="#9c422c" stroke-width="0.25"/>
        <rect x="25" y="25" width="50" height="50" stroke="#1c2d42" stroke-width="0.5"/>
        <circle cx="50" cy="50" r="10" stroke="#9c422c" stroke-width="0.5" fill="#faf8f5"/>
      </svg>
    </div>
  </section>

  <!-- Research Tracks Grid -->
  <section class="mb-16">
    <div class="border-l-2 border-brand-rust pl-4 mb-8">
      <h2 class="text-2xl font-bold font-lora text-brand-slate uppercase tracking-wide">Core Research Tracks</h2>
      <p class="text-sm text-brand-muted">Primary streams of theoretical and applied sequence investigation.</p>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
      <div class="border border-brand-border/40 rounded p-6 bg-white shadow-sm flex flex-col justify-between hover:border-brand-rust transition-all">
        <div class="space-y-4">
          <div class="w-8 h-8 rounded-full bg-blue-50 border border-blue-200 flex items-center justify-center text-blue-800 text-xs font-bold">A</div>
          <h3 class="text-xl font-bold font-lora text-brand-slate">Efficient Language-Model Inference</h3>
          <p class="text-sm text-stone-600 leading-relaxed">
            Optimizing the computational footprint of massive models, specifically focusing on runtime value evaluation, attention weights, and key-value (KV) cache compression for infinite-context sequences.
          </p>
        </div>
        <a href="/research#track-a" class="inline-flex items-center text-xs font-semibold text-brand-rust hover:underline mt-6">
          Explore Track Details →
        </a>
      </div>

      <div class="border border-brand-border/40 rounded p-6 bg-white shadow-sm flex flex-col justify-between hover:border-brand-rust transition-all">
        <div class="space-y-4">
          <div class="w-8 h-8 rounded-full bg-amber-50 border border-amber-200 flex items-center justify-center text-amber-800 text-xs font-bold">B</div>
          <h3 class="text-xl font-bold font-lora text-brand-slate">Computational Analysis of Indus Script</h3>
          <p class="text-sm text-stone-600 leading-relaxed">
            Applying statistical natural language processing, Markov transitional probability modeling, and entropy analysis to decode structural and grammatical constraints in undeciphered ancient sign sequences.
          </p>
        </div>
        <a href="/research#track-b" class="inline-flex items-center text-xs font-semibold text-brand-rust hover:underline mt-6">
          Explore Track Details →
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Publications Section -->
  <section class="border-t border-brand-border/40 pt-16 mb-16">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-2xl font-bold font-lora text-brand-slate">Featured Research</h2>
        <p class="text-sm text-brand-muted">Peer-reviewed publications and research output highlights.</p>
      </div>
      <a href="/publications" class="text-xs font-semibold text-brand-rust hover:underline no-print">
        All Publications ({allPublications.length}) →
      </a>
    </div>

    <div class="space-y-6">
      {featuredPublications.map(pub => (
        <PublicationCard publication={pub} />
      ))}
    </div>
  </section>

  <!-- Featured Presentation / Talk Section -->
  {featuredTalks.length > 0 && (
    <section class="border-t border-brand-border/40 pt-16 mb-16">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-2xl font-bold font-lora text-brand-slate">Selected Presentations</h2>
          <p class="text-sm text-brand-muted">Invited lectures and academic talks.</p>
        </div>
        <a href="/talks" class="text-xs font-semibold text-brand-rust hover:underline no-print">
          All Talks ({allTalks.length}) →
        </a>
      </div>

      <div class="space-y-6">
        {featuredTalks.map(talk => (
          <TalkCard talk={talk} />
        ))}
      </div>
    </section>
  )}

  <!-- Short Bio Section -->
  <section class="border-t border-brand-border/40 pt-16 mb-16 bg-brand-sand/20 rounded p-8 border border-brand-border/20">
    <div class="grid md:grid-cols-3 gap-8 items-start">
      <div class="space-y-2">
        <h2 class="text-2xl font-bold font-lora text-brand-slate">About Tanishk</h2>
        <p class="text-xs text-brand-muted">B.Tech Student, AI & ML</p>
        <p class="text-xs text-stone-500 font-semibold uppercase tracking-wider">Class of 2028</p>
      </div>
      
      <div class="md:col-span-2 space-y-4 text-sm text-stone-600 leading-relaxed">
        <p>
          I am currently pursuing my Bachelor of Technology (B.Tech) in Artificial Intelligence and Machine Learning at Delhi Skill and Entrepreneurship University in New Delhi, India. 
        </p>
        <p>
          My work is primarily interdisciplinary, sitting at the junction of structural constraints in sequence modeling—whether optimizing high-speed computational resources for state-of-the-art transformer LLMs or examining transitional dynamics in ancient undeciphered corpus datasets.
        </p>
        <p class="pt-2 font-semibold">
          <a href="/about" class="text-brand-rust hover:underline flex items-center gap-1.5 focus:outline-none">
            <span>Read more about my academic background</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </p>
      </div>
    </div>
  </section>
</Layout>
