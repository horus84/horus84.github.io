---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import TalkCard from '../components/TalkCard.astro';

const talks = await getCollection('talks');
const sorted = talks.sort((a, b) => {
  const year = (s: string) => parseInt(s.match(/\d{4}/)?.[0] || '0', 10);
  return year(b.data.date) - year(a.data.date);
});
---

<Layout
  title="Talks | Tanishk Tiwari"
  description="Talks and presentations by Tanishk Tiwari, including NLP4DH/ACL 2026 and invited lectures on Indus script research."
>
  <div class="shell section">
    <div class="section-head reveal">
      <div>
        <span class="section-num">TALKS</span>
        <h1 class="display-lg">Talks &amp; <span class="serif text-acid">presentations.</span></h1>
      </div>
      <p class="label max-w-[22rem]">Lectures, conference presentations, and public research talks.</p>
    </div>

    <div class="reveal">
      {sorted.map((talk) => <TalkCard talk={talk} />)}
    </div>
  </div>
</Layout>
