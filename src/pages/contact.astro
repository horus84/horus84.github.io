---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact | Tanishk Tiwari"
  description="Contact Tanishk Tiwari for research collaborations, internship opportunities, or questions about LLM inference, interpretability, and computational epigraphy."
>
  <div class="shell section">
    <div class="section-head reveal">
      <div>
        <span class="section-num">CONTACT</span>
        <h1 class="display-lg">Let's build something <span class="serif text-acid">rigorous.</span></h1>
      </div>
    </div>

    <div class="grid gap-6 md:grid-cols-2 max-w-4xl reveal">
      <a href="mailto:t.high1945@gmail.com" class="panel panel-hover p-8 block">
        <p class="label label-acid mb-4">Email</p>
        <h2 class="text-2xl font-semibold">Direct correspondence</h2>
        <p class="text-sm text-dim mt-3">Best for research collaboration, internship discussions, or academic inquiries.</p>
        <p class="text-link mt-6">t.high1945@gmail.com <span aria-hidden="true">↗</span></p>
      </a>

      <a href="https://github.com/horus84" target="_blank" rel="noopener noreferrer" class="panel panel-hover p-8 block">
        <p class="label mb-4">GitHub</p>
        <h2 class="text-2xl font-semibold">Code &amp; artifacts</h2>
        <p class="text-sm text-dim mt-3">Research repos, experiments, benchmarks, and tools.</p>
        <p class="text-link mt-6">github.com/horus84 <span aria-hidden="true">↗</span></p>
      </a>
    </div>

    <div class="grid gap-6 md:grid-cols-3 max-w-4xl mt-6 reveal">
      <div class="panel p-6">
        <p class="label mb-2">Location</p>
        <p class="text-sm text-bone">New Delhi, India</p>
        <p class="text-sm text-dim mt-1">Delhi Skill and Entrepreneurship University</p>
      </div>
      <a href="https://www.linkedin.com/in/Tanishk-Tiwari-2/" target="_blank" rel="noopener noreferrer" class="panel panel-hover p-6 block">
        <p class="label mb-2">LinkedIn</p>
        <p class="text-link">Tanishk-Tiwari-2 <span aria-hidden="true">↗</span></p>
      </a>
      <a href="https://orcid.org/0009-0004-6482-4479" target="_blank" rel="noopener noreferrer" class="panel panel-hover p-6 block">
        <p class="label mb-2">ORCID</p>
        <p class="text-link">0009-0004-6482-4479 <span aria-hidden="true">↗</span></p>
      </a>
    </div>
  </div>
</Layout>
