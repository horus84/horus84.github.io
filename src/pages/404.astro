---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="404 — Not Found | Tanishk Tiwari"
  description="The requested page could not be found."
>
  <div class="shell section">
    <div class="max-w-2xl reveal">
      <p class="label label-acid mb-6">Error 404</p>
      <h1 class="display-xl">Out of <span class="serif text-acid">bounds.</span></h1>
      <p class="text-dim mt-6 max-w-lg leading-relaxed">
        The page you're looking for doesn't exist, moved, or never made it into the corpus.
      </p>
      <div class="mt-10 flex gap-4">
        <a href="/" class="btn btn-primary">Return home <span aria-hidden="true">→</span></a>
        <a href="/research" class="btn btn-outline">View research</a>
      </div>
    </div>
  </div>
</Layout>
