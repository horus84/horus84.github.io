---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="404 - Sequence Not Found | Tanishk Tiwari" 
  description="The requested page could not be found on Tanishk Tiwari's personal research website."
>
  <div class="max-w-md mx-auto text-center space-y-8 py-16">
    <div class="space-y-4">
      <span class="font-lora text-6xl font-bold text-brand-rust italic">404</span>
      <h1 class="text-2xl font-bold text-brand-slate font-lora">Sequence Not Found</h1>
      <p class="text-sm text-stone-600 leading-relaxed">
        The page you are looking for does not exist, has been moved, or is structurally out of bounds. Let's return to the home sequence.
      </p>
    </div>
    
    <div>
      <a 
        href="/" 
        class="inline-flex items-center justify-center px-5 py-2.5 bg-brand-slate text-white hover:bg-brand-rust font-semibold rounded shadow transition-all duration-150 text-sm focus:outline-none focus:ring-2 focus:ring-brand-rust"
      >
        Return Home
      </a>
    </div>
  </div>
</Layout>
