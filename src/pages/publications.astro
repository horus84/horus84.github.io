---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PublicationCard from '../components/PublicationCard.astro';

const publications = await getCollection('publications');
const sorted = publications.sort((a, b) => {
  if (a.data.status === 'in-progress' && b.data.status !== 'in-progress') return -1;
  if (a.data.status !== 'in-progress' && b.data.status === 'in-progress') return 1;
  return b.data.year - a.data.year;
});
---

<Layout
  title="Publications | Tanishk Tiwari"
  description="Publications and research writing by Tanishk Tiwari on LLM inference, Indus script statistical structure, and computational epigraphy."
>
  <div class="shell section">
    <div class="section-head reveal">
      <div>
        <span class="section-num">WRITING</span>
        <h1 class="display-lg">Papers &amp; <span class="serif text-acid">publications.</span></h1>
      </div>
      <p class="label max-w-[22rem]">Peer-reviewed work, preprints, and research in progress.</p>
    </div>

    <div class="reveal">
      {sorted.map((pub) => <PublicationCard publication={pub} />)}
    </div>
  </div>
</Layout>
