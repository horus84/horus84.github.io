---
interface Props {
  talk: {
    id: string;
    data: {
      title: string;
      venue: string;
      location: string;
      date: string;
      summary: string;
      slidesLink?: string;
      videoLink?: string;
      featured: boolean;
    };
  };
}

const { talk } = Astro.props;
const { title, venue, location, date, summary, slidesLink, videoLink } = talk.data;
---

<article class="paper-row">
  <div class="min-w-0">
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mb-3">
      <span class="label label-acid">{date}</span>
      <span class="label">{venue}</span>
      <span class="label">{location}</span>
    </div>

    <h3 class="text-xl md:text-2xl font-semibold tracking-tight leading-snug">{title}</h3>
    <p class="text-sm text-dim mt-3 leading-relaxed max-w-3xl">{summary}</p>
  </div>

  <div class="flex md:flex-col gap-3 md:items-end shrink-0 no-print">
    {slidesLink && <a href={slidesLink} target="_blank" rel="noopener noreferrer" class="text-link">Slides <span aria-hidden="true">↗</span></a>}
    {videoLink && <a href={videoLink} target="_blank" rel="noopener noreferrer" class="text-link">Video <span aria-hidden="true">↗</span></a>}
  </div>
</article>
