---
interface Props {
  publication: {
    id: string;
    data: {
      title: string;
      authors: string;
      venue: string;
      year: number;
      status: 'published' | 'preprint' | 'in-progress';
      summary: string;
      paperLink?: string;
      codeLink?: string;
      slidesLink?: string;
      tags: string[];
      featured: boolean;
    };
  };
}

const { publication } = Astro.props;
const { title, authors, venue, year, status, summary, paperLink, codeLink, slidesLink, tags } = publication.data;
const id = publication.id.replace(/[^a-zA-Z0-9-]/g, '');

const statusLabel = status === 'in-progress' ? 'In Progress' : status === 'preprint' ? 'Preprint' : 'Published';
const statusDot = status === 'in-progress' ? 'ember' : status === 'preprint' ? '' : 'dim';

const authorParts = authors.split('Tanishk Tiwari');
---

<article class="paper-row">
  <div class="min-w-0">
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mb-3">
      <span class="label">{year}</span>
      <span class="status"><span class:list={['status-dot', statusDot]}></span>{statusLabel}</span>
      <span class="label">{venue}</span>
    </div>

    <h3 class="text-xl md:text-2xl font-semibold tracking-tight leading-snug">
      {paperLink ? (
        <a href={paperLink} target="_blank" rel="noopener noreferrer" class="hover:text-acid transition-colors">
          {title}
        </a>
      ) : title}
    </h3>

    <p class="text-sm text-dim mt-3">
      {authorParts.length === 2 ? (
        <>{authorParts[0]}<strong class="text-bone font-medium">Tanishk Tiwari</strong>{authorParts[1]}</>
      ) : authors}
    </p>

    {summary && (
      <div class="mt-4 no-print">
        <button
          class="abstract-toggle text-link"
          data-target={`abstract-${id}`}
          aria-expanded="false"
          aria-controls={`abstract-${id}`}
        >
          <span>Abstract</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div id={`abstract-${id}`} class="hidden mt-4 p-4 border border-line bg-panel text-sm text-dim leading-relaxed">
          {summary}
        </div>
      </div>
    )}

    <div class="flex flex-wrap gap-2 mt-4">
      {tags.map((tag) => <span class="tag">{tag}</span>)}
    </div>
  </div>

  <div class="flex md:flex-col gap-3 md:items-end shrink-0 no-print">
    {paperLink && <a href={paperLink} target="_blank" rel="noopener noreferrer" class="text-link">Paper <span aria-hidden="true">↗</span></a>}
    {codeLink && <a href={codeLink} target="_blank" rel="noopener noreferrer" class="text-link">Code <span aria-hidden="true">↗</span></a>}
    {slidesLink && <a href={slidesLink} target="_blank" rel="noopener noreferrer" class="text-link">Slides <span aria-hidden="true">↗</span></a>}
  </div>
</article>

<script>
  function setupAbstractToggles() {
    document.querySelectorAll('.abstract-toggle').forEach((toggle) => {
      const fresh = toggle.cloneNode(true) as HTMLButtonElement;
      toggle.parentNode?.replaceChild(fresh, toggle);
      fresh.addEventListener('click', () => {
        const targetId = fresh.getAttribute('data-target');
        if (!targetId) return;
        const target = document.getElementById(targetId);
        if (!target) return;
        const expanded = fresh.getAttribute('aria-expanded') === 'true';
        fresh.setAttribute('aria-expanded', String(!expanded));
        target.classList.toggle('hidden');
        fresh.querySelector('svg')?.classList.toggle('rotate-180');
        const label = fresh.querySelector('span');
        if (label) label.textContent = expanded ? 'Abstract' : 'Hide';
      });
    });
  }
  setupAbstractToggles();
  document.addEventListener('astro:after-swap', setupAbstractToggles);
</script>
