        Sitemap
      </a>
    </div>
  </div>
  
  <div class="max-w-5xl mx-auto px-6 mt-8 pt-6 border-t border-brand-border/20 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 text-xs text-brand-muted">
    <p>© {year} Tanishk Tiwari. All rights reserved.</p>
    <p>Designed and built with Astro, TypeScript & Tailwind CSS 4.</p>
  </div>
</footer>
