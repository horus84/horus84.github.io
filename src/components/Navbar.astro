---
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.slice(1); // remove leading slash

const navItems = [
  { name: 'Research', path: '/research' },
  { name: 'Publications', path: '/publications' },
  { name: 'Projects', path: '/projects' },
  { name: 'Talks', path: '/talks' },
  { name: 'About', path: '/about' },
  { name: 'CV', path: '/cv' },
  { name: 'Contact', path: '/contact' },
];
---

<header class="sticky top-0 z-40 w-full bg-brand-bg/95 backdrop-blur-md border-b border-brand-border/40 no-print transition-all duration-200">
  <div class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
    <!-- Logo Monogram -->
    <a href="/" class="flex items-center gap-2 group focus:outline-none focus:ring-2 focus:ring-brand-rust focus:ring-offset-2 rounded px-1" aria-label="Tanishk Tiwari Home">
      <span class="font-lora text-xl font-bold tracking-tight text-brand-slate flex items-center">
        T<span class="text-brand-rust font-lora">T</span>
      </span>
      <span class="hidden sm:inline font-lora text-sm font-medium text-brand-muted group-hover:text-brand-slate transition-colors duration-150 pl-2 border-l border-brand-border/40">
        Tanishk Tiwari
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center space-x-6 text-sm font-medium" aria-label="Main Navigation">
      {navItems.map(item => {
        // Handle matches for subpages (e.g. /publications matches publications)
        const isActive = currentPath === item.path.slice(1) || (item.path !== '/' && currentPath.startsWith(item.path.slice(1)));
        return (
          <a
            href={item.path}
            class={`relative py-1 text-stone-600 hover:text-brand-slate transition-colors duration-150 focus:outline-none focus:ring-2 focus:ring-brand-rust focus:ring-offset-2 rounded px-1 ${isActive ? 'text-brand-rust font-semibold' : ''}`}
          >
            {item.name}
            {isActive && (
              <span class="absolute bottom-0 left-0 w-full h-0.5 bg-brand-rust rounded-full" />
            )}
          </a>
        )
      })}
      
      <!-- Action: Download CV -->
      <a
        href="/cv/CV_TanT.pdf"
        download
        class="inline-flex items-center justify-center px-3.5 py-1.5 border border-brand-rust text-xs text-brand-rust hover:bg-brand-rust hover:text-white transition-all duration-150 rounded font-semibold tracking-wide uppercase focus:outline-none focus:ring-2 focus:ring-brand-rust focus:ring-offset-2"
        aria-label="Download CV as PDF"
      >
        CV (PDF)
      </a>
    </nav>

    <!-- Mobile Navigation Toggle -->
    <button
      id="mobile-menu-toggle"
      class="md:hidden p-2 text-stone-600 hover:text-brand-slate transition-colors focus:outline-none focus:ring-2 focus:ring-brand-rust focus:ring-offset-2 rounded"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Toggle navigation menu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" id="hamburger-icon">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" id="close-icon">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden bg-brand-bg border-b border-brand-border/40 absolute top-16 left-0 w-full z-30 transition-all duration-300 ease-in-out shadow-lg"
  >
    <div class="px-6 py-4 flex flex-col space-y-4 text-base font-medium">
      {navItems.map(item => {
        const isActive = currentPath === item.path.slice(1) || (item.path !== '/' && currentPath.startsWith(item.path.slice(1)));
        return (
          <a
            href={item.path}
            class={`py-2 text-stone-600 hover:text-brand-slate transition-colors duration-150 ${isActive ? 'text-brand-rust font-semibold border-l-2 border-brand-rust pl-2' : ''}`}
          >
            {item.name}
          </a>
        )
      })}
      <a
        href="/cv/tanishk_tiwari_cv.pdf"
        download
        class="inline-flex items-center justify-center py-2.5 border border-brand-rust text-sm text-brand-rust hover:bg-brand-rust hover:text-white transition-all duration-150 rounded font-semibold text-center uppercase tracking-wide"
      >
        Download CV (PDF)
      </a>
    </div>
  </div>
</header>

<script>
  function setupNavbar() {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');

    if (!toggleBtn || !mobileMenu) return;

    // Remove existing event listeners by cloning button
    const newToggleBtn = toggleBtn.cloneNode(true);
    toggleBtn.parentNode?.replaceChild(newToggleBtn, toggleBtn);

    newToggleBtn.addEventListener('click', () => {
      const isExpanded = newToggleBtn.getAttribute('aria-expanded') === 'true';
      newToggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      
      mobileMenu.classList.toggle('hidden');
      hamburgerIcon?.classList.toggle('hidden');
      closeIcon?.classList.toggle('hidden');
    });

    const mobileLinks = mobileMenu.querySelectorAll('a');
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        newToggleBtn.setAttribute('aria-expanded', 'false');
        hamburgerIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
      });
    });
  }

  // Run on initial load and view transitions
  setupNavbar();
  document.addEventListener('astro:after-swap', setupNavbar);
</script>
