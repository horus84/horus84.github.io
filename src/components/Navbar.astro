---
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, '') || '/';

const navItems = [
  { name: 'Research', path: '/research' },
  { name: 'Work', path: '/projects' },
  { name: 'Now', path: '/now' },
  { name: 'Papers', path: '/publications' },
  { name: 'Talks', path: '/talks' },
  { name: 'About', path: '/about' },
  { name: 'CV', path: '/cv' },
];

const isActive = (path: string) => currentPath === path || currentPath.startsWith(`${path}/`);
---

<header class="site-header no-print">
  <div class="shell h-[68px] flex items-center justify-between gap-6">
    <a href="/" class="group flex items-center gap-3" aria-label="Tanishk Tiwari — home">
      <span class="grid place-items-center w-9 h-9 border border-acid text-acid font-mono text-xs tracking-widest group-hover:bg-acid group-hover:text-ink transition-colors">TT</span>
      <span class="hidden sm:block font-display font-semibold text-[0.95rem] tracking-tight">
        Tanishk <span class="text-dim">Tiwari</span>
      </span>
    </a>

    <nav class="hidden lg:flex items-center gap-6" aria-label="Main navigation">
      {navItems.map((item, i) => (
        <a
          href={item.path}
          class:list={['nav-link', isActive(item.path) && 'active']}
          aria-current={isActive(item.path) ? 'page' : undefined}
        >
          <span class="nav-index">{String(i + 1).padStart(2, '0')}</span>{item.name}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a href="mailto:t.high1945@gmail.com" class="hidden md:inline-flex btn btn-outline py-2 px-3">
        Get in touch <span aria-hidden="true">↗</span>
      </a>

      <button
        id="menu-toggle"
        class="lg:hidden w-9 h-9 grid place-items-center border border-line text-bone"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <svg id="icon-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M3 7h18M3 12h18M3 17h18" />
        </svg>
        <svg id="icon-close" class="hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M5 5l14 14M19 5L5 19" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden fixed inset-x-0 top-[68px] bottom-0 z-40 bg-ink overflow-y-auto">
    <div class="shell py-10 flex flex-col">
      {navItems.map((item, i) => (
        <a
          href={item.path}
          class:list={[
            'flex items-baseline gap-4 py-4 border-b border-line',
            isActive(item.path) ? 'text-acid' : 'text-bone'
          ]}
        >
          <span class="font-mono text-xs text-faint">{String(i + 1).padStart(2, '0')}</span>
          <span class="text-2xl font-semibold tracking-tight">{item.name}</span>
        </a>
      ))}
      <a href="mailto:t.high1945@gmail.com" class="btn btn-primary mt-8 self-start">
        t.high1945@gmail.com
      </a>
    </div>
  </div>
</header>

<script>
  function setupNav() {
    const toggle = document.getElementById('menu-toggle') as HTMLButtonElement | null;
    const menu = document.getElementById('mobile-menu');
    const open = document.getElementById('icon-open');
    const close = document.getElementById('icon-close');
    if (!toggle || !menu) return;

    const fresh = toggle.cloneNode(true) as HTMLButtonElement;
    toggle.replaceWith(fresh);

    const setState = (expanded: boolean) => {
      fresh.setAttribute('aria-expanded', String(expanded));
      menu.classList.toggle('hidden', !expanded);
      open?.classList.toggle('hidden', expanded);
      close?.classList.toggle('hidden', !expanded);
      document.body.style.overflow = expanded ? 'hidden' : '';
    };

    fresh.addEventListener('click', () => setState(fresh.getAttribute('aria-expanded') !== 'true'));
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setState(false)));
    window.addEventListener('keydown', (e) => { if (e.key === 'Escape') setState(false); });
  }

  setupNav();
  document.addEventListener('astro:after-swap', setupNav);
</script>
