---
interface Props {
  project: {
    id: string;
    data: {
      title: string;
      description: string;
      status: string;
      codeLink?: string;
      demoLink?: string;
      tags: string[];
      featured: boolean;
      track: 'llm' | 'indus' | 'other';
    };
  };
}

const { project } = Astro.props;
const { title, description, status, codeLink, demoLink, tags, track } = project.data;
---

<div class="p-6 border border-brand-border/40 rounded bg-white hover:border-brand-rust hover:shadow-md transition-all duration-150 flex flex-col justify-between group shadow-sm">
  <div class="space-y-3">
    <div class="flex items-center justify-between gap-2">
      <span class={`text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded ${
        track === 'llm' 
          ? 'bg-blue-50 text-blue-800 border border-blue-200' 
          : track === 'indus' 
            ? 'bg-amber-50 text-amber-800 border border-amber-200' 
            : 'bg-stone-50 text-stone-700 border border-stone-200'
      }`}>
        {track === 'llm' ? 'LLM Inference' : track === 'indus' ? 'Indus Script' : 'Exploratory'}
      </span>
      <span class="text-xs text-brand-muted font-medium italic">{status}</span>
    </div>
    
    <h3 class="text-lg font-bold text-brand-slate font-lora group-hover:text-brand-rust transition-colors duration-150">
      {title}
    </h3>
    
    <p class="text-sm text-stone-600 leading-relaxed">
      {description}
    </p>
  </div>

  <div class="mt-5 space-y-3">
    <!-- Tags -->
    <div class="flex flex-wrap gap-1">
      {tags.map((tag) => (
        <span class="inline-block text-[10px] text-stone-500 bg-stone-100 rounded-sm px-2 py-0.5 border border-stone-200/40">
          {tag}
        </span>
      ))}
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-4 pt-2 text-xs font-semibold no-print">
      {codeLink && (
        <a
          href={codeLink}
          target="_blank"
          rel="noopener noreferrer"
          class="text-brand-slate hover:text-brand-rust transition-colors flex items-center gap-1 focus:underline focus:outline-none"
        >
          <span>Repository</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      )}
      {demoLink && (
        <a
          href={demoLink}
          target="_blank"
          rel="noopener noreferrer"
          class="text-brand-slate hover:text-brand-rust transition-colors flex items-center gap-1 focus:underline focus:outline-none"
        >
          <span>Demo</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      )}
    </div>
  </div>
</div>
