---
interface Props {
  project: {
    id: string;
    data: {
      title: string;
      description: string;
      status: string;
      codeLink?: string;
      demoLink?: string;
      tags: string[];
      featured: boolean;
      track: 'llm' | 'indus' | 'other';
    };
  };
}

const { project } = Astro.props;
const { title, description, status, codeLink, demoLink, tags, track } = project.data;

const trackLabel = track === 'llm' ? 'LLM Systems' : track === 'indus' ? 'Indus / Epigraphy' : 'Exploratory';
const trackClass = track === 'llm' ? 'label-acid' : track === 'indus' ? 'label-ember' : '';
---

<article class="project-card panel panel-hover h-full">
  <div>
    <div class="flex items-start justify-between gap-4 mb-5">
      <p class:list={['label', trackClass]}>{trackLabel}</p>
      <span class="label text-right">{status}</span>
    </div>

    <h3 class="text-xl font-semibold tracking-tight leading-snug">{title}</h3>
    <p class="text-sm text-dim mt-3 leading-relaxed">{description}</p>
  </div>

  <div class="mt-6 pt-5 border-t border-line">
    <div class="flex flex-wrap gap-2 mb-4">
      {tags.map((tag) => <span class="tag">{tag}</span>)}
    </div>

    {(codeLink || demoLink) && (
      <div class="flex flex-wrap gap-4 no-print">
        {codeLink && (
          <a href={codeLink} target="_blank" rel="noopener noreferrer" class="text-link">
            Repository <span aria-hidden="true">↗</span>
          </a>
        )}
        {demoLink && (
          <a href={demoLink} target="_blank" rel="noopener noreferrer" class="text-link">
            Demo <span aria-hidden="true">↗</span>
          </a>
        )}
      </div>
    )}
  </div>
</article>
